ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# Build this once, record its resulting content ID, and use that exact image for all modes.
# No host mounts, credentials, session history or benchmark outputs enter the image.
RUN apt-get -o Acquire::Retries=3 update && apt-get install -y --no-install-recommends \
    iptables binutils gdb gcc g++ make git curl wget unzip file openssh-client libgmp-dev \
    libmpfr-dev libmpc-dev libssl-dev libffi-dev && rm -rf /var/lib/apt/lists/*
COPY node-runtime /opt/node-runtime
ENV PATH=/opt/node-runtime/bin:${PATH}
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --index-url ${PIP_INDEX_URL} --timeout 60 MarkupSafe==3.0.2 Mako==1.3.10 requests==2.32.3 beautifulsoup4==4.12.3 bottle==0.13.2 \
    simple-websocket-server==0.4.4 aiohttp==3.11.13 pycryptodome==3.21.0 pwntools==4.14.0 \
    sympy==1.13.3 pillow==11.1.0 numpy==2.2.3 z3-solver==4.14.0.0 gmpy2==2.2.1
COPY app /opt/secheur
RUN python -c 'import importlib.metadata,json,platform,subprocess; from pathlib import Path; Path("/opt/toolchain.json").write_text(json.dumps({"node":subprocess.check_output(["node","--version"],text=True).strip(),"python":platform.python_version(),"packages":sorted((d.metadata["Name"],d.version) for d in importlib.metadata.distributions())},sort_keys=True))'
WORKDIR /workspace
RUN mkdir -p /state && chown 1000:1000 /workspace /state
ENV SECHEUR_PROJECT_ROOT=/workspace SECHEUR_CONFIG_DIR=/state SECHEUR_AGENT_DIR=/model-config \
    SECHEUR_LEGACY_ROOT=/opt/secheur/legacy SECHEUR_PYTHON=/usr/local/bin/python \
    BRIDGE_HOST=0.0.0.0 SECHEUR_MANAGED_SESSIONS=1
USER 1000:1000
ENTRYPOINT ["node", "/opt/secheur/packages/secheur-agent/dist/bridge-cli.js"]
