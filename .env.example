# Docker Compose project and images
COMPOSE_PROJECT_NAME=secheur-agent
SECHEUR_IMAGE=secheur-agent:local
CTF_MCP_IMAGE=ctf-mcp:ubuntu24-core

# Host exposure. Keep loopback unless a private network or reverse proxy protects it.
SECHEUR_BIND_HOST=127.0.0.1
SECHEUR_PORT=14168
CTF_MCP_BIND_HOST=127.0.0.1
CTF_MCP_PORT=18080

# Runtime behavior
SECHEUR_PERMISSION_MODE=default
SECHEUR_LANG=zh

# RepoAudit is preinstalled in the Agent image. Production scans require the
# model-family credential selected by REPOAUDIT_MODEL; keep secrets outside Git.
REPOAUDIT_REQUIRE_API_KEY=1
REPOAUDIT_MODEL=claude-3.7
REPOAUDIT_TIMEOUT_MS=1800000
REPOAUDIT_LOCK_TIMEOUT_MS=300000
REPOAUDIT_LOCK_STALE_MS=120000
REPOAUDIT_HEARTBEAT_MS=25000

# The Bridge tool-stalled watchdog must be comfortably longer than the heartbeat.
SECHEUR_AGENT_OUTPUT_IDLE_TIMEOUT=90

# Reserved for a future distributed coordinator. The current adapter only
# implements a per-container file lock; setting these does not enable one yet.
REPOAUDIT_COORDINATION_MODE=file-lock
REPOAUDIT_CENTRAL_QUEUE_URL=
REPOAUDIT_SHARED_LEASE_URL=

# Persistent mounts. Replace a name with ./runtime/<name> to use bind mounts.
SECHEUR_STATE_MOUNT=secheur-state
SECHEUR_WORKSPACE_MOUNT=secheur-workspace
CTF_WORK_MOUNT=ctf-work

# Optional CTF image features. Full builds require substantial time and disk space.
CTF_PLATFORM=linux/amd64
INSTALL_SAGE=1
INSTALL_GHIDRA=1
INSTALL_EXTRA_MCPS=0

# Configure model credentials through the SecHeur settings UI or a private
# mounted runtime directory. Never add API keys to this file in Git.
# Optional bootstrap keys. Missing provider entries are added to Pi auth.json;
# existing provider credentials are preserved.
# SECHEUR_DEEPSEEK_API_KEY=
# SECHEUR_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SECHEUR_GLM_API_KEY=

# Official DASCTF competition API. Keep the AccessKey private; the bridge reads
# these values at startup. The Main Agent syncs open unsolved challenges through
# the explicit competition_sync workflow; the attach-only bridge never schedules work.
# The web page is https://gcsis.dasctf.com/1629, but the Agent API Server Host
# is https://pro.dasctf.com; send the page's numeric match ID separately.
# SLAB_MATCH_HOST=https://pro.dasctf.com
# SLAB_MATCH_ID=1629
# SLAB_AGENT_ACCESSKEY=
# Detail requests: at most five exercises per ten-second batch.
# SLAB_EXERCISE_DETAIL_BATCH_SIZE=5
# SLAB_EXERCISE_DETAIL_BATCH_INTERVAL_MS=10000
# WORKLIST_SYNC_INTERVAL_MS=30000
# WORKLIST_MAX_ENVIRONMENTS=3
# WORKLIST_MAX_FAILURES=2
# WORKLIST_MAX_FLAG_ATTEMPTS=3
# WORKLIST_EXCLUDE_EXERCISE_IDS=10792,10793
# WORKLIST_ULTRACODE=0

# Competition broker. The broker stores leases, task events, attachments, and
# submission audit records in SQLite and exposes a separate Unix socket.
# COMPETITION_MAX_ENVIRONMENTS=3
# COMPETITION_ENVIRONMENT_LEASE_TTL_MS=1800000
# COMPETITION_ATTACHMENT_MAX_CONCURRENT=3
# COMPETITION_ATTACHMENT_MAX_BYTES=536870912
# SECHEUR_COMPETITION_DATABASE=.secheur-agent/competition.sqlite
# SECHEUR_COMPETITION_SOCKET=.secheur-agent/competition.sock

# Optional local CTFd + ctf-lab-gateway adapter. CTFd credentials stay in the
# broker process and are never copied into task snapshots or solver processes.
# Start the local stack with: docker compose --profile local-ctf up -d --build
# The gateway config must reference a locally built, versioned challenge image;
# the example intentionally does not pull or pretend to provide 10756.
# CTFD_PORT=18000
# CTFD_SECRET_KEY=replace-this-local-secret
# CTFD_DB_USER=ctfd
# CTFD_DB_PASSWORD=ctfd-local-password
# CTFD_DB_ROOT_PASSWORD=ctfd-local-root-password
# CTFD_BIND_HOST=127.0.0.1
# Compose local profile: CTFD_URL=http://ctfd:8000 (host-only install: http://127.0.0.1:8000)
# CTFD_URL=http://ctfd:8000
# CTFD_API_TOKEN=
# CTFd-side agent contract. The access key is shared only by the CTFd plugin
# and the Main Agent; CTFD_AGENT_USER_ID is the CTFd service account used for
# solved state, attachment URLs, score, and flag submissions.
# CTFD_AGENT_ACCESS_KEY=
# CTFD_AGENT_USER_ID=1
# CTFD_AGENT_API_URL=http://ctfd:8000/slab-match/api/v1/agent
# CTFD_AGENT_GATEWAY_URL=http://ctf-lab-gateway:8090
# CTF_LAB_GATEWAY_URL=http://ctf-lab-gateway:8090
# CTF_LAB_MAX_ENVIRONMENTS=3
# CTF_LAB_ENVIRONMENT_TTL_SECONDS=1800
# CTF_LAB_ADVERTISE_HOST=host.docker.internal
# CTF_LAB_CHALLENGE_CONFIG=./docker/ctf-lab-gateway/challenges.example.json

# Main Agent solver creation is serialized and spaced to keep tool results and
# tmux startup traffic bounded. Values are clamped to 1000..5000 milliseconds.
# SECHEUR_SOLVER_DISPATCH_INTERVAL_MS=2000

# BigModel GLM route and Responses runner for the local 10756 workflow. Never commit this key.
# BIGMODEL_API_KEY=
# BIGMODEL_RESPONSES_ENDPOINT=https://open.bigmodel.cn/api/v1/responses
# BIGMODEL_MODEL=glm-5.3
# SECHEUR_MODEL_REQUEST_TIMEOUT_MS=120000

# Optional Ultracode overrides. Pi auth.json is preferred for credentials.
# ULTRACODE_AGENT_MODEL=secheur-deepseek/deepseek-v4-flash
# Candidate Pi reasoning defaults to max; DeepSeek adapts it to the model.
# ULTRACODE_THINKING_LEVEL=max
# auto submits only when a Flag Oracle is configured; required fails closed.
# ULTRACODE_FLAG_VERIFY=auto
# ULTRACODE_CHALLENGE_ID=
# ULTRACODE_VERIFIER_MODEL=secheur-deepseek/deepseek-v4-flash
# ULTRACODE_VERIFIER_API=openai-responses
# ULTRACODE_VERIFIER_BASE_URL=https://api.deepseek.com
# ULTRACODE_VERIFIER_API_KEY=
# ULTRACODE_VERIFIER_HEADERS=
# ULTRACODE_VERIFIER_WHOLE_ENDPOINT=1
# ULTRACODE_MODE=auto
