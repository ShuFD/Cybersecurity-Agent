{
  "mcpServers": {
    "ctf-toolbox": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "--platform", "linux/amd64",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "-v", "/ABS/PATH/TO/work:/work",
        "ctf-mcp:ubuntu24-core",
        "python3", "/opt/ctf-mcp/server.py"
      ]
    }
  }
}
